{
  "name": "amt-studio",
  "version": "0.3.1",
  "private": true,
  "description": "Self-hosted Intel AMT and JetKVM management with browser KVM, SOL, virtual media and team access",
  "author": "AMT Studio",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "server": "node server/server.cjs",
    "start:web": "npm run build && node server/server.cjs",
    "test:browser": "node scripts/run-browser-checks.cjs",
    "docs:screenshots": "node scripts/docs-screenshots.cjs",
    "check:public": "node scripts/check-public.cjs",
    "tls:init": "node scripts/init-tls.cjs"
  },
  "dependencies": {
    "@device-management-toolkit/ui-toolkit": "3.3.22",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fast-xml-parser": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LyriC-spec/amt-studio.git"
  },
  "homepage": "https://github.com/LyriC-spec/amt-studio",
  "bugs": {
    "url": "https://github.com/LyriC-spec/amt-studio/issues"
  }
}
